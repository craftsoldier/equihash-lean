/-
BLAKE2b on the test vector of RFC 7693, Appendix A: BLAKE2b-512 of `"abc"`, with no key and
a zero personalization; then BLAKE2b-400 of 144 bytes, two blocks, personalized as Equihash's
`(200, 9)` hash is, with the digest Python's `hashlib.blake2b` gives. Each is checked on
RFC 7693's model and on the specification.
-/
import Equihash.Verifier.Blake2b
import Equihash.Spec.Blake2b

open Equihash Equihash.Verifier.Blake2b

/-- `"abc"`, and its BLAKE2b-512 (RFC 7693, Appendix A). -/
def abc : List ℕ := "abc".toList.map Char.toNat

def abcDigest : List ℕ :=
  [0xBA, 0x80, 0xA5, 0x3F, 0x98, 0x1C, 0x4D, 0x0D, 0x6A, 0x27, 0x97, 0xB6, 0x9F, 0x12, 0xF6, 0xE9,
   0x4C, 0x21, 0x2F, 0x14, 0x68, 0x5A, 0xC4, 0xB7, 0x4B, 0x12, 0xBB, 0x6F, 0xDB, 0xFF, 0xA2, 0xD1,
   0x7D, 0x87, 0xC5, 0x39, 0x2A, 0xAB, 0x79, 0x2D, 0xC2, 0x52, 0xD5, 0xDE, 0x45, 0x33, 0xCC, 0x95,
   0x18, 0xD3, 0x8A, 0xA8, 0xDB, 0xF1, 0x92, 0x5A, 0xB9, 0x23, 0x86, 0xED, 0xD4, 0x00, 0x99, 0x23]

/-- `"ZcashPoW"`, then 200 and 9 as 32-bit little-endian integers. -/
def zcashPersonal : List ℕ :=
  [0x5A, 0x63, 0x61, 0x73, 0x68, 0x50, 0x6F, 0x57, 200, 0, 0, 0, 9, 0, 0, 0]

/-- Bytes 0 to 139, then 7 as a 32-bit little-endian integer. -/
def zcashInput : List ℕ := List.range 140 ++ [7, 0, 0, 0]

def zcashDigest : List ℕ :=
  [0xE7, 0x94, 0x28, 0xF4, 0x37, 0x2F, 0x46, 0xE5, 0xE9, 0x55, 0xF1, 0x5F, 0xB6, 0x39, 0x8A, 0xAD,
   0x29, 0xCB, 0xCB, 0xC3, 0xE8, 0xFE, 0xA5, 0x45, 0x0C, 0x1A, 0xBB, 0xCC, 0x5E, 0x45, 0x8C, 0xAB,
   0x32, 0xBB, 0xE8, 0x48, 0xB5, 0xDC, 0x1A, 0x71, 0xB9, 0x2B, 0x8C, 0x4F, 0xB7, 0x8F, 0x47, 0x78,
   0x3F, 0xB1]

/-- The specification's `BLAKE2b-ℓ(p, x)`, on bytes as numbers. -/
def specBlake2b (len : ℕ) (hlen : len ≤ 64) (p x : List ℕ) : List ℕ :=
  if hp : p.length = 16 then
    (Spec.Blake2b.blake2b len hlen ⟨p.map (BitVec.ofNat 8), by simp [hp]⟩
      (x.map (BitVec.ofNat 8))).toList.map BitVec.toNat
  else []

#guard blake2b 64 (List.replicate 16 0) abc = abcDigest
#guard specBlake2b 64 (by decide) (List.replicate 16 0) abc = abcDigest
#guard blake2b 50 zcashPersonal zcashInput = zcashDigest
#guard specBlake2b 50 (by decide) zcashPersonal zcashInput = zcashDigest
